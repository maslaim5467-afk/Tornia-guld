# Sprite-sheet coordinates in pixels; origin is top-left.
# Format: clip <name> <frame-duration-ms> <loop|once>
#         frame <x> <y> <width> <height>
# Rectangles isolate the character pixels; no per-frame PNG files are needed.

clip idle 180 loop
frame 78 42 109 167
frame 246 43 99 165
frame 402 43 103 165
frame 558 42 113 166
end

clip walk_down 120 loop
frame 884 42 102 170
frame 1032 44 91 169
frame 1167 44 98 169
frame 1310 42 103 170
end

clip walk_up 120 loop
frame 79 251 106 166
frame 241 252 98 164
frame 402 252 93 164
frame 555 251 108 165
end

clip walk_left 120 loop
frame 848 253 115 164
frame 1006 253 108 161
frame 1165 253 124 163
frame 1321 253 131 163
end

clip walk_right 120 loop
frame 80 460 116 151
frame 242 460 111 151
frame 406 461 104 152
frame 561 459 110 154
end

